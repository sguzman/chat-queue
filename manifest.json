{
  "manifest_version": 3,
  "name": "Chat Queue (Prototype)",
  "version": "0.1.0",
  "description": "A local, Signal-gated message queue and HUD for ChatGPT.",
  "permissions": ["storage"],
  "background": { "scripts": ["src/signal.js", "src/background.js"] },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["src/core.js", "src/signal.js", "src/content.js"],
    "run_at": "document_idle", "all_frames": false
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "chat-queue@sguzman.github",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
